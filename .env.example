# Copy this file to .env and replace the placeholder secrets.
# The repository-level .env is shared by all four portfolio projects.

# Required shared settings
OPENAI_API_KEY=your-openai-api-key
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Optional: defaults to neo4j when omitted.
NEO4J_DATABASE=neo4j

# Optional project-specific tuning values and their defaults
RESEARCH_MIN_SEMANTIC_SCORE=0.25
OPS_MIN_SEMANTIC_SCORE=0.22
OPS_MAX_AGENT_ROUNDS=5
FRAUD_MIN_SEMANTIC_SCORE=0.24
FRAUD_MAX_AGENT_ROUNDS=6
