  "documents": [
    {"documentId": "TYPO-001", "documentType": "typology", "title": "Rapid circulation and mule-ring indicators", "relatedAccountIds": [], "relatedDeviceIds": [], "relatedMerchantIds": [], "sections": [
      {"heading": "Pattern", "text": "Rapid movement of materially similar values through three or more accounts can indicate layering or mule coordination when the elapsed time is short."},
      {"heading": "Corroboration", "text": "Shared devices, phones, addresses, young accounts, fan-in before circulation, and concentrated cash-out strengthen the pattern. No single shared identifier proves common control."},
      {"heading": "Alternative explanations", "text": "Households, carers, shared workplaces, payment retries, and legitimate treasury flows can create overlap. Review tenure, transaction purpose, normal behaviour, and customer relationships."}
    ]},
    {"documentId": "TYPO-002", "documentType": "typology", "title": "Shared identifier investigation guide", "relatedAccountIds": [], "relatedDeviceIds": [], "relatedMerchantIds": [], "sections": [
      {"heading": "Entity resolution", "text": "Treat a shared device, phone, or address as a relationship signal. Compare how many independent identifiers overlap and whether linked accounts transact with one another."},
      {"heading": "Benign overlap", "text": "Long account tenure, a shared residential address, distinct personal phones, ordinary household transfers, and unrelated spending are evidence consistent with a benign household."}
    ]},
    {"documentId": "TYPO-003", "documentType": "typology", "title": "Digital-goods merchant cash-out", "relatedAccountIds": [], "relatedDeviceIds": [], "relatedMerchantIds": [], "sections": [
      {"heading": "Pattern", "text": "A cluster that directs a large share of recent inbound funds to a single digital-goods or voucher merchant may be converting funds into transferable value."},
      {"heading": "Checks", "text": "Check merchant history, refund behaviour, delivery evidence, account age, source-of-funds context, and whether the merchant appears across otherwise connected clusters."}
    ]},
    {"documentId": "POL-001", "documentType": "policy", "title": "Grounded fraud investigation standard", "relatedAccountIds": [], "relatedDeviceIds": [], "relatedMerchantIds": [], "sections": [
      {"heading": "Evidence standard", "text": "Separate observed facts from derived graph patterns and typology matches. Use suspected or consistent-with language; an alert is not a determination of fraud."},
      {"heading": "Proportionality", "text": "Document contradictory and benign evidence before escalation. Recommend reversible checks and human review; do not automatically block a customer based only on graph proximity."},
      {"heading": "Data gaps", "text": "State missing KYC, device telemetry, IP history, payment narrative, counterparty-bank information, merchant fulfilment, and customer-contact evidence when relevant."}
    ]},
    {"documentId": "CASE-RPT-8001", "documentType": "case_report", "title": "Closed case: Kent wallet mule pair", "relatedAccountIds": ["A-401", "A-402"], "relatedDeviceIds": ["D-800"], "relatedMerchantIds": ["M-800"], "sections": [
      {"heading": "Observed network", "text": "Accounts A-401 and A-402 shared device D-800 and phone PH-800. A-401 transferred GBP 1,200 to A-402, which spent GBP 1,175 at Nova Voucher Exchange four minutes later."},
      {"heading": "Resolution", "text": "The accounts were closed after customer contact, device telemetry, and voucher redemption records supported coordinated third-party control. The graph pattern alone was not the decision basis."},
      {"heading": "Reusable lesson", "text": "The combination of multiple shared identifiers, fast pass-through, and concentrated digital-goods spend was more discriminating than any individual signal."}
    ]},
    {"documentId": "BENIGN-RPT-1001", "documentType": "case_report", "title": "Closed alert: Morgan household tablet", "relatedAccountIds": ["A-001", "A-002"], "relatedDeviceIds": ["D-001"], "relatedMerchantIds": [], "sections": [
      {"heading": "Observed network", "text": "A-001 and A-002 shared a residential address and household tablet but used distinct phones. Their only direct payment was a regular GBP 400 household transfer."},
      {"heading": "Resolution", "text": "Long tenure, ordinary salary and household spend, and verified family relationship supported closure as benign shared access."}
    ]}
  ]
